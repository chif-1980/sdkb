YUXI_ENV=development
YUXI_INSTANCE_ID=
YUXI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
OPENAI_API_BASE=
# 飞书企业自建应用专用；真实值写入本机 `.env`，不要写入或提交此示例文件。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 企业知识助手完成飞书登录后的后端回调地址。
FEISHU_PRODUCT_REDIRECT_URI=
# 知识加工管理员完成飞书用户授权后的回调地址。
FEISHU_KNOWLEDGE_REDIRECT_URI=http://127.0.0.1:5173/api/feishu-knowledge/oauth/callback
# 手机扫码授权回调；本地开发需填写手机可访问的局域网地址，生产环境使用 HTTPS 域名。
FEISHU_KNOWLEDGE_QR_REDIRECT_URI=
# 可选 Fernet 密钥；为空时使用 JWT_SECRET_KEY 经域隔离派生。
FEISHU_OAUTH_TOKEN_ENCRYPTION_KEY=
# 企业知识助手唯一允许检索的已启用飞书知识源 ID。
PRODUCT_FEISHU_SOURCE_ID=
JWT_SECRET_KEY=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=yuxi
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_URI=
MILVUS_URI=
MILVUS_TOKEN=
SANDBOX_PROVISIONER_TOKEN=replace-me
LITE_MODE=false
