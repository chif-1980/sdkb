  "cards": [
    {
      "dot": "cyan",
      "title": "可信来源",
      "items": [
        "飞书原文是来源事实",
        "未审核、未发布内容不进入正式问答"
      ]
    },
    {
      "dot": "emerald",
      "title": "治理闭环",
      "items": [
        "会议建议与反馈可触发知识治理请求",
        "发布后到原建议的闭环回写仍需核验"
      ]
    },
    {
      "dot": "rose",
      "title": "人工兜底",
      "items": [
        "扫描失败可重试",
        "缺少证据时由维护人员补充原文"
      ]
    }
