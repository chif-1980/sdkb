          "source",
          "scan",
          "review",
          "publish",
          "formal"
        ],
        "note": "只有审核通过并发布的版本进入正式问答。"
      },
      {
        "id": "meeting-feedback",
        "label": "会议与反馈触发",
        "focus": [
          "source",
          "review",
          "publish",
          "formal"
        ],
        "note": "会议建议和用户反馈最终进入同一审核发布链。"
      },
      {
        "id": "failure",
        "label": "失败与人工处理",
        "focus": [
          "scan-failed",
          "review",
          "manual-close"
        ],
        "note": "扫描失败可重试；缺少证据时先完善原文再审核。"
      }
    ],
    "viewBox": [
      1050,
      652
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "backend": {
          "label": "业务处理"
        },
        "security": {
          "label": "人工确认 / 异常"
        },
        "messagebus": {
          "label": "异步执行"
        },
        "database": {
          "label": "业务记录"
        }
      }
    }
  },
