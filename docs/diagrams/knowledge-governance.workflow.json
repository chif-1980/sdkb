      "to": "review",
      "label": "提交审核包",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "review-publish",
      "from": "review",
      "to": "publish",
      "label": "审核通过",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "publish-formal",
      "from": "publish",
      "to": "formal",
      "label": "切换正式版本",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "formal-answer",
      "from": "formal",
      "to": "answer",
      "label": "检索引用",
      "role": "main",
      "variant": "default"
