{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "企业知识助手问答与引用时序",
    "locale": "zh-CN",
    "output": "assistant-answer.html",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1100,
      680
    ]
  },
  "participants": [
    {
      "id": "user",
      "type": "frontend",
      "label": "助手前端"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "产品问答 API"
    },
    {
      "id": "access",
      "type": "security",
      "label": "身份与来源权限"
    },
    {
      "id": "retrieval",
      "type": "database",
      "label": "正式知识检索"
    },
    {
      "id": "model",
      "type": "external",
      "label": "模型服务"
    }
  ],
  "messages": [
    {
      "id": "step-1",
      "from": "user",
      "to": "api",
      "label": "提交问题、模式与会话",
      "variant": "emphasis",
      "y": 170
    },
    {
      "id": "step-2",
      "from": "api",
      "to": "access",
      "label": "校验登录与知识源范围",
      "variant": "security",
      "y": 202
    },
    {
      "id": "step-3",
      "from": "access",
      "to": "api",
      "label": "返回可用身份与授权范围",
      "variant": "return",
      "y": 234
    },
    {
      "id": "step-4",
      "from": "api",
      "to": "retrieval",
      "label": "检索可访问的正式知识",
      "variant": "emphasis",
      "y": 266
    },
    {
      "id": "step-5",
      "from": "retrieval",
      "to": "api",
      "label": "返回证据片段与来源信息",
      "variant": "return",
      "y": 298
    },
    {
      "id": "step-6",
      "from": "api",
      "to": "model",
      "label": "结合问题、证据与上下文生成",
      "variant": "emphasis",
      "y": 330
    },
    {
      "id": "step-7",
      "from": "model",
      "to": "api",
      "label": "生成回答内容",
      "variant": "return",
      "y": 362
    },
    {
      "id": "step-8",
      "from": "api",
      "to": "user",
      "label": "返回流式回答与引用",
      "variant": "return",
      "y": 394
    },
    {
      "id": "step-9",
      "from": "user",
      "to": "api",
      "label": "点击引用请求来源详情",
      "variant": "default",
      "y": 426
    },
    {
      "id": "step-10",
      "from": "api",
      "to": "access",
      "label": "再次校验来源访问权限",
      "variant": "security",
      "y": 458
    },
    {
      "id": "step-11",
      "from": "api",
      "to": "user",
      "label": "返回有权查看的原文定位",
      "variant": "return",
      "y": 490
    },
    {
      "id": "step-12",
      "from": "user",
      "to": "api",
      "label": "提交满意度与问题反馈",
      "variant": "default",
      "y": 522
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "证据边界",
      "items": [
        "正式企业知识按可访问范围检索",
        "会话附件作为本轮上下文，不自动发布"
      ]
    },
    {
      "dot": "emerald",
      "title": "两种模式",
      "items": [
        "快速回答适合日常查询",
        "深度查证扩大核对深度，不扩大权限"
      ]
    },
    {
      "dot": "amber",
      "title": "异常处理",
      "items": [
        "没有足够证据时明确说明",
        "引用校验失败不能当作正式答案"
      ]
    }
  ]
}
