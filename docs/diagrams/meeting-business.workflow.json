{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "会议纪要到任务闭环",
    "locale": "zh-CN",
    "output": "meeting-business.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy-path",
        "label": "正常闭环",
        "focus": [
          "input",
          "analysis",
          "review",
          "delivery",
          "sync",
          "archive"
        ],
        "note": "从会议输入到纪要、待办、飞书同步和归档。"
      },
      {
        "id": "delivery-failure",
        "label": "发送异常",
        "focus": [
          "review",
          "delivery",
          "delivery-failed"
        ],
        "note": "飞书写入失败时保留错误、支持重试和人工处理。"
      },
      {
        "id": "remote-change",
        "label": "远端变化",
        "focus": [
          "sync",
          "diff",
          "manual-reconcile"
        ],
        "note": "回读比较负责人和期限；本地待发送修改不会被回读覆盖。"
      }
    ],
    "viewBox": [
      1050,
      652
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "backend": {
          "label": "业务处理"
        },
        "security": {
          "label": "人工确认 / 异常"
        },
        "messagebus": {
          "label": "异步执行"
        },
        "database": {
          "label": "业务记录"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "employee",
      "label": "员工与助手"
    },
    {
