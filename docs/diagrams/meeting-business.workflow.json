  "edges": [
    {
      "id": "capture-analysis",
      "from": "input",
      "to": "analysis",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "analysis-review",
      "from": "analysis",
      "to": "review",
      "label": "生成结果",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "review-delivery",
      "from": "review",
      "to": "delivery",
      "label": "确认后发送",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "delivery-sync",
      "from": "delivery",
      "to": "sync",
      "label": "任务编号",
      "role": "main",
      "variant": "dashed"
    },
    {
      "id": "sync-archive",
      "from": "sync",
      "to": "archive",
      "label": "状态与差异",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "delivery-failure",
      "from": "delivery",
      "to": "delivery-failed",
      "label": "写入异常",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "retry-delivery",
      "from": "delivery-failed",
      "to": "delivery",
      "label": "幂等重发",
      "role": "return",
      "variant": "dashed"
    },
    {
      "id": "remote-diff",
      "from": "sync",
      "to": "diff",
      "label": "远端已变更",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "reconcile-archive",
      "from": "manual-reconcile",
      "to": "archive",
      "label": "写入审计",
      "role": "return",
      "variant": "dashed"
    },
    {
      "id": "diff-reconcile",
      "from": "diff",
      "to": "manual-reconcile",
      "label": "核对处理",
      "role": "branch",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "主链验收",
      "items": [
        "分析结果必须可编辑并有版本校验",
        "发送、回读、归档都有明确状态"
      ]
    },
    {
      "dot": "orange",
      "title": "异常验收",
      "items": [
        "失败可见且能重试",
        "本地修改不被远端状态静默覆盖"
      ]
    },
    {
      "dot": "rose",
      "title": "当前补强",
      "items": [
        "事件订阅与完整字段冲突处理属于规划",
        "会议归档是人工操作，不等于待办均完成"
      ]
    }
  ]
}
